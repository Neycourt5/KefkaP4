<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.9.0</Version>
    <PackageProjectUrl>https://github.com/Neycourt5/KefkaP4</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Description>Local-only Kefka P4 position practice overlay.</Description>
    <AssemblyTitle>Kefka P4 Trainer</AssemblyTitle>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enabled for AtkUnitBase.PlaySoundEffect; Dalamud exposes no sound API.
         Reaching the addon means a raw pointer, hence unsafe blocks. -->
    <Use_Dalamud_FFXIVClientStructs>true</Use_Dalamud_FFXIVClientStructs>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Use_Dalamud_Newtonsoft_Json>false</Use_Dalamud_Newtonsoft_Json>
    <!-- LocalPlayer.ClassJob is a Lumina RowRef, needed to detect the mit seat. -->
    <Use_Dalamud_Lumina>true</Use_Dalamud_Lumina>
    <Use_Dalamud_Lumina_Excel>true</Use_Dalamud_Lumina_Excel>
    <Use_Dalamud_Serilog>false</Use_Dalamud_Serilog>
    <Use_Dalamud_MSObjectPool>false</Use_Dalamud_MSObjectPool>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KefkaP4Trainer.Core\KefkaP4Trainer.Core.csproj" />
  </ItemGroup>
</Project>
